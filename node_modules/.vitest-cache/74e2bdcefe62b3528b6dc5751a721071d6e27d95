// State global
let tasks = [];

// Menghasilkan unique ID menggunakan crypto.randomUUID() dengan fallback ke Date.now()
function generateId() {
  if (typeof crypto !== 'undefined' && crypto.randomUUID) {
    return crypto.randomUUID();
  };
  return Date.now().toString();
};

// Mengembalikan string error atau null jika valid (Requirements 1.4)
function validateTaskText(text) {
  const trimmed = (text || '').trim();
  if (trimmed.length === 0) {
    return 'Tugas tidak boleh kosong.';
  };
  if (trimmed.length > 200) {
    return 'Tugas tidak boleh melebihi 200 karakter.';
  };
  return null;
};

// Mengecek apakah task list sudah penuh >= 100 (Requirements 1.6)
function isTaskListFull() {
  return tasks.length >= 100;
};

// Membuat Task baru; melempar error jika input tidak valid atau list penuh (Requirements 1.2, 1.4, 1.6, 1.7)
function addTask(text) {
  if (isTaskListFull()) {
    throw new Error('Batas maksimum 100 tugas telah tercapai.');
  };
  const errorMsg = validateTaskText(text);
  if (errorMsg !== null) {
    throw new Error(errorMsg);
  };
  const task = {
    id: generateId(),
    text: text.trim(),
    completed: false,
  };
  tasks.push(task);
  return task;
};

// Mengubah status selesai Task; melempar error jika id tidak ditemukan (Requirements 2.2, 2.3)
function toggleTask(id) {
  const task = tasks.find(t => t.id === id);
  if (!task) {
    throw new Error(`Task dengan id "${id}" tidak ditemukan.`);
  };
  task.completed = !task.completed;
};

// Menghapus Task dari list; melempar error jika id tidak ditemukan (Requirements 3.2)
function deleteTask(id) {
  const index = tasks.findIndex(t => t.id === id);
  if (index === -1) {
    throw new Error(`Task dengan id "${id}" tidak ditemukan.`);
  };
  tasks.splice(index, 1);
};

// For testing: get reference to tasks array
function getTasks() { return tasks; };
// For testing: reset tasks array
function setTasks(newTasks) { tasks = newTasks; };

// Menyimpan state dari memory ke localStorage (Requirements 4.1, 4.2, 4.3)
function saveTasks() {
  try {
    localStorage.setItem('todo-list-tasks', JSON.stringify(tasks));
  } catch (e) {
    console.warn('localStorage tidak tersedia. Data tidak akan tersimpan.', e);
  }
};

// Memuat state dari localStorage ke memory (Requirements 4.4, 4.5, 4.6)
function loadTasks() {
  try {
    const raw = localStorage.getItem('todo-list-tasks');
    if (raw === null) {
      tasks = [];
      return;
    };
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) {
      tasks = [];
      return;
    };
    // Skip items tanpa field wajib (id, text, completed)
    tasks = parsed.filter(item =>
      item !== null &&
      typeof item === 'object' &&
      typeof item.id === 'string' && item.id.length > 0 &&
      typeof item.text === 'string' &&
      typeof item.completed === 'boolean'
    );
  } catch (e) {
    // JSON parse error atau exception lain → empty state, tidak ada pesan error ke user
    tasks = [];
  }
};

